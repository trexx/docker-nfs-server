{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "extends": [
    "docker:enableMajor",
    "docker:pinDigests",
    "default:automergeDigest",
    "default:automergeMinor",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "dockerfile",
    "github-actions"
  ],
  "packageRules": [
    {
      "description": "Own actions and workflows follow main; don't update or pin them",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "trexx/**"
      ],
      "enabled": false
    }
  ]
}
